[Unit]
Description=aerospacefunnel: derive flight legs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/aerospacefunnel
ExecStart=%h/aerospacefunnel/.venv/bin/aerospacefunnel legs
# Upstream failures are recorded in pipeline_run rather than raised, so a non-zero exit
# means a real local fault worth surfacing.
StandardOutput=journal
StandardError=journal
