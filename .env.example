# Copy to .env and fill in whatever you have. NOTHING here is required -
# every source with a credential also has an anonymous path.
#
#   cp .env.example .env && aerospacefunnel keys
#
# .env is gitignored. Never commit real values.

# --- OpenSky: 400 credits/day anonymous -> 4,000/day, 10s -> 5s resolution ---
# Register at https://opensky-network.org/ then create an API client.
# NOTE: OpenSky documents itself as "research and non-commercial" use.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- FAA NOTAM API (free) -> https://api.faa.gov/s/ ---
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# --- EIA jet fuel spot prices (free) -> https://www.eia.gov/opendata/register.php ---
EIA_API_KEY=

# --- NASA space weather (free) -> https://api.nasa.gov/ ---
# A registered key is 1,000 req/hr. DEMO_KEY's live limit measured at 10/hr.
NASA_API_KEY=

# --- Launch Library 2: PAID ONLY (Patreon). There is no free tier above 15 req/hr. ---
# Leave blank unless you subscribe: https://www.patreon.com/TheSpaceDevs
LL2_TOKEN=
